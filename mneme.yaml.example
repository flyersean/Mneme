# ============================================================================
#  Mneme proxy config — EXAMPLE (copy to $MNEME_CHUNK_DIR/mneme.yaml and edit)
# ============================================================================
#
#  WHAT THIS FILE IS
#    The single place to tune how the Mneme memory proxy behaves. Copy it next
#    to the database as mneme.yaml; the proxy reads it at startup, then
#    hot-reloads most settings whenever the file changes (see runtime.hot_reload).
#
#  HOW A SETTING IS RESOLVED (highest wins)
#    1. Environment variable (MNEME_*)
#    2. This file
#    3. Built-in default
#    An env var overrides whatever you write here. Watch the startup log's
#    [CONFIG] lines to see the FINAL resolved value of every setting.
#
#  HOW TO APPLY A CHANGE
#    Most settings hot-reload on save — edit the file and the change applies to
#    the next request (no restart): sampling.*, models.*, storage.memory_only /
#    storage.memory_enabled / storage.inject_enabled, mcp_servers, and the
#    injected prompts. Structural settings (backend, providers, port, db_path)
#    still need a restart. Set runtime.hot_reload: false to lock everything
#    (changes then require a restart).
#
#  FULL REFERENCE
#    This file IS the reference — every setting below is commented.
#
#  TUNING CHEAT-SHEET
#    * retrieval.inject_min_similarity  — the "how similar before I inject a
#      memory" gate. RAISE -> fewer / only high-confidence memories; LOWER ->
#      more recall (and more noise). ⚠ EMBEDDER-DEPENDENT: re-tune this whenever
#      you change the embedding model — see the retrieval section below.
#    * sampling.temperature             — creativity. Lower = more deterministic.
#    * retrieval.max_injected_tokens    — how much memory to stuff into the prompt.
#
#  NOTE: the values below are tuned for the OpenRouter lineup
#  (deepseek/deepseek-v4-flash + voyage-4-lite + llama-3.2-3b-instruct), informed
#  by asking the model itself. A global max_tokens cap is intentionally OMITTED —
#  it truncated thorough document summaries. Anti-hang is enforced by timeouts.
# ============================================================================

# Which backend to talk to. `openai` here means "any OpenAI-compatible
# provider" (selected in `providers:`), NOT literally OpenAI.
backend:
  type: openai          # "ollama" | "openai"
  provider: openrouter  # which `providers:` entry to use (ignored when type=ollama)
  ollama_url: http://localhost:11434   # used only when type=ollama

# Providers. Adding a new OpenAI-standard provider (OpenAI, DeepSeek, Groq,
# Together, Mistral, ...) is just a new block here — no code changes.
providers:
  openrouter:
    base_url: https://openrouter.ai/api/v1
    api_key_env: OPENROUTER_API_KEY       # key is read from THIS env var, never stored here
    model: deepseek/deepseek-v4-flash     # chat model
    embed_model: voyageai/voyage-4-lite   # model that turns text into searchable vectors
    label_model: meta-llama/llama-3.2-3b-instruct  # model that writes short topic labels
    # OpenRouter reliability (ignored by any other OpenAI-compatible provider).
    fallback_models: ["google/gemini-2.5-flash"]
    provider: {}                 # e.g. { preferred_max_latency: { p90: 30 } }
    stream: true                 # true = stream; false = let OR buffer + fail over
  deepseek:
    base_url: https://api.deepseek.com
    api_key_env: DEEPSEEK_API_KEY
    model: deepseek-chat
    embed_model: ""                       # empty -> disable embeddings (reuse another's)
    label_model: meta-llama/llama-3.2-3b-instruct

# Default generation settings. Per-model overrides under `models:` beat these.
sampling:
  temperature: 0.2      # randomness; 0.2 = fairly deterministic (less repetition)
  top_p: 0.9            # nucleus sampling — cut off the improbable tail
  top_k: 64             # ollama only (ignored by the openai path)
  ctx_tokens: 65536     # context window size handed to the model — MUST match the model's num_ctx
  completion_reserve: 8192  # tokens reserved for the model's reply, out of ctx_tokens
  # Reasoning/thinking is OFF by default (a reasoning model can runaway-think on
  # a trivial ask). Set reasoning_enabled: 1 to opt back in globally; reasoning_effort
  # (low/high/max) is for effort-level models (deepseek etc.). A per-model
  # `reasoning:` / `reasoning_effort:` under `models:` overrides this for one model.
  reasoning_enabled: 0
  # max_tokens: leave unset — a global output cap truncates long summaries

# Anti-hang guardrails, not tuning knobs — leave unless a provider is flaky.
timeouts:
  chat_timeout: 300       # seconds to wait for a chat reply (OpenAI-style backends)
  ollama_chat_timeout: 300  # Ollama — cold-start model loading delays the first token
  first_token_timeout: 180  # abort if no first token arrives (hung provider)
  novelty_timeout: 600    # timeout for the slower multi-step novelty/strategy calls
  embed_timeout: 60       # embedding request timeout
  label_timeout: 30       # topic-labeling request timeout
  edge_failures: 2        # consecutive failures before treating a model as an "edge case"
  edge_ratio: 0.5         # fraction of recent turns failing that trips the edge-case detector

# Where things live and how memory is staged.
storage:
  chunk_dir: ~/mneme/chunks      # per-instance dir (prompts, tools, logs); config is found via --config/MNEME_CONFIG
  db_path: ~/mneme/chunks/mneme.db  # the memory DB file; FAISS index lives beside it (portable/shared). Independent of chunk_dir — set it explicitly for a shared/external DB (unset falls back to <chunk_dir>/mneme.db with a warning).
  port: 8080                 # HTTP port the proxy listens on
  inject_system: true        # prepend Mneme's system instructions (system_prompt.md) to the prompt
  memory_only: false         # true = memory-only build: the EXPERIMENTAL strategy/self-improving layer is OFF by
                             # default (memory + grading + tools stay on). Not dead — it's developed and tested on
                             # the unified_mneme branch and merged back into main. main defaults true, unified false.
  memory_enabled: true       # master switch: false = NO memory — no retrieval/injection, no staging/archiving, search_memory off (run through the proxy with tools only)
  inject_enabled: true       # false = SAVE-ONLY mode: skip memory retrieval/injection (models see NO memory context),
                             # but turns are still staged/archived, and search_memory + /search still work. Good for
                             # swarms: models aren't bombarded with context, but their work is persisted + pullable on demand.
  staging_turns: 1           # flush the recent conversation into a memory chunk every N turns (swarm default: 1 = every turn)
  staging_idle: 120          # ...or after this many seconds of silence (whichever first)
  context_recent_extra: 14   # recent-convo window = staging_turns + this many USER TURNS (kept in the tool loop instead of the full transcript)
  belief_evolution: false    # experimental — OFF (floods the backend)

# Memory curation: fixing bad memory WITHOUT wiping the database.
#
# The problem: if a hallucinated fact gets saved and re-injected, it becomes
# self-reinforcing — and the only other way to remove it was /reset (delete
# everything). Retraction marks ONE chunk as false and can be undone.
#
# Nothing here judges whether a claim is TRUE. It records provenance: who said
# it, how many independent times, what it was derived from, and whether a human
# disputed it. Provenance is checkable; truth usually is not.
curation:
  # May the MODEL retract a memory directly? This is destructive — a model that
  # is confidently wrong would happily delete the correct facts contradicting it
  # (exactly the hallucinated-validation failure). OFF by default.
  allow_model_retract: false
  # May the MODEL flag a memory for you to review? Safe, so ON by default:
  # while a proposal is pending the chunk is still used normally, so a wrong
  # model judgement can never silently hide correct information. Confirm or deny
  # each one via /memory/proposals.
  allow_model_propose: true
  # Inject retracted chunks as a labelled warning [RETRACTED ... DO NOT TRUST]
  # instead of dropping them. Default ON because absence is dangerous: with
  # nothing to contradict it, the model can simply re-hallucinate the same fact.
  # Set false to exclude retracted chunks from retrieval entirely.
  inject_retracted: true
  # Label chunks by how well-supported they are — [SINGLE-SOURCE CLAIM ...] when
  # asserted once, [REPEATED BY MODEL ONLY ...] when only the model has repeated
  # it (could be an echo of itself), and [SELF-CONFIRMED ...] when a chunk's
  # support traces back to the model's own output. No label = corroborated by a
  # non-model source (user, fetched page, or tool result).
  recurrence_labeling: true

# Memory retrieval: what gets injected into the prompt each turn.
retrieval:
  max_injected_tokens: 8000  # token budget for memory stuffed into the prompt (~6-8 chunks)
  inject_min_similarity: 0.45  # THE main knob: absolute similarity floor. A memory is injected
                               # only if it scores >= this. Below it -> inject NOTHING.
                               # ⚠ EMBEDDER-DEPENDENT — every embedding model has its own
                               # similarity scale, so tune this per embedder, not once. Measure it by
                               # embedding a few obviously-relevant vs obviously-irrelevant queries.
                               #   voyage-4-lite:            noise ~0.48, relevant ~0.70 -> use ~0.62
                               #   snowflake-arctic-embed2:  noise ~0.32, relevant ~0.40 -> use ~0.45
                               # RAISE = stricter/fewer; LOWER = more recall (and more noise).
  strategy_min_similarity: 0.40  # SECOND floor (must be < inject_min_similarity). Same embedder
                                 # dependency as above. A chunk scoring
                                 # in [strategy_min_similarity, inject_min_similarity) does NOT inject
                                 # as memory, but any strategy LINKED to that chunk still injects — so
                                 # a learned approach generalizes to same-concept queries that fall just
                                 # under the memory floor. Strategies are retrieved by their SOURCE CHUNK,
                                 # not by a problem-type taxonomy.
  keyword_fallback: false    # pad sparse FAISS with LIKE-substring matches. OFF by default —
                             # substring hits have no semantic score and pollute context.
  route_threshold: 0.08      # DEPRECATED for retrieval (route_query keys on inject_min_similarity);
                             # still referenced by the /search debug endpoint.
  classify_threshold: 0.78   # UNUSED (dead config) — no "is this a memory query?" gate yet.
  baseline_noise: 0.20       # fallback only — auto-calibrated at startup (_calibrate_noise()).
  age_decay_days: 7          # recency half-life (days) — newer memories rank higher
  max_siblings: 3            # max sibling chunks pulled in per topic when a hit is expanded
  topic_switch_sim: 0.45     # topic-switch detection: a turn whose cosine vs the last few turns
                             # is below this is treated as a NEW topic (same embedder dependency
                             # as inject_min_similarity; 0 = disable detection).
  topic_switch_grace: 2      # turns to harden injection after a topic switch (0 = off)
  novel_inject_floor: 0.60   # raised injection floor during the switch grace window — keeps the
                             # old dominant topic from re-injecting while the new topic settles
  max_per_topic: 3           # cap on injected chunks per topic_label (0 = off). Stops one topic
                             # with hundreds of chunks from crowding out everything else.
  max_chunk_words: 500       # split user messages longer than this many words
  max_chunk_size: 10000      # chars per chunk for embedding; overflow becomes sibling chunks

# Character/truncation limits. Rarely tuned.
caps:
  max_history_messages: 32   # how many recent messages are sent to the model
  db_msg_cap: 8000           # chars per message stored in SQLite
  compress_threshold: 500    # tool results longer than this (chars) get staged/compressed
  compress_max_tok: 2048     # max tokens for the compression summarizer
  max_tool_forward: 12000    # cap on a tool result forwarded to the model (head+tail window)
  tool_followup_tokens: 10000  # tokens reserved for tool results in the input; recent-window = ctx_tokens - completion_reserve - this
  chunk_size: 4000           # chars per staged memory chunk

# Inbuilt tools — enable/disable each one. `native` (auto|on|off) controls the
# bash/write bootstrap; the rest are the read-only server tools. Set any to false
# to hide it from the model (handy for a restricted or memory-less proxy).
# `inject_min_similarity` / `inject_max` / `inject_tokens` auto-inject relevant
# built-tool descriptions into context (retrieval-gated) so the model knows a
# tool exists; the model can always `list_tools` / `read_tool` manually regardless.
tools:
  native: auto               # bash/write bootstrap: auto | on | off  (NOT a boolean — "off" to disable)
  dir: ~/mneme/chunks/tools  # where the model's built tools live (defaults to <chunk_dir>/tools)
  bash_timeout: 30           # seconds before a bash command is killed
  inject_min_similarity: 0.75  # auto-inject a built tool's description only if the query scores >= this
  inject_max: 3              # max built tools auto-injected into context per turn
  inject_tokens: 600         # token budget for the injected tool descriptions
  search_memory: true        # memory search tool
  list_tools: true           # list the tools you've built
  read_tool: true            # read a built tool's source
  read_file: true            # read host files by path
  fetch_url: true            # fetch + clean a web page
  web_search: true           # web search

# Per-model overrides (beat the `sampling:` defaults). Keyed by exact model name.
# Supported keys: temperature, top_p, top_k, min_p, presence_penalty,
# repetition_penalty, num_ctx, num_predict, reasoning (true/false),
# reasoning_effort (low/medium/xhigh — passed to Ollama, e.g. Qwen3.8).
models:
  deepseek/deepseek-v4-flash:
    temperature: 0.2
    top_p: 0.9
  muse-glimmer:30b:
    temperature: 1.0
    top_k: 64
    num_ctx: 32768
  # A reasoning/vision model. Mneme sends think:false by default, which some
  # Qwen3.8 GGUFs can't handle (they emit NOTHING — the "empty response" bug).
  # `reasoning: true` stops that (lets the model think); `reasoning_effort` keeps
  # the thinking shallow if your Ollama passes it through. Match its recommended
  # sampling and cap its 256K window to what fits in the pod's VRAM.
  orcarouter/Qwen3.8-27B-Uncensored:
    reasoning: false         # disable thinking — it over-thinks and stalls
    num_ctx: 32768           # cap the 256K window to what fits in VRAM
    num_predict: 2048        # cap the reply — this model otherwise writes ~3000 tokens per answer

# Model Context Protocol (MCP) servers — the "install any tool and it just works"
# layer. Each server's tools are surfaced to the model like built-in tools, and
# run through the MCP server (which can be Python/Node/Go/anything — MCP is
# language-agnostic JSON-RPC).
#
# Two transports:
#   * stdio  — the proxy spawns `command args` as a subprocess and owns its
#              lifecycle. The common local case (npx/uvx/local scripts).
#   * HTTP   — connect to an already-running streamable-HTTP MCP server via `url`.
#
# Hot-reloadable: editing this block (add/remove/change a server) takes effect on
# the running proxy with no restart. You can also POST/DELETE /mcp/servers at
# runtime for instant add/remove (those are in-memory only — write here to persist).
#
# A tool name that collides with a built-in tool is shadowed by the built-in.
mcp_servers:
  # ── stdio server (the proxy launches a local command and speaks MCP to it) ──
  # Hound — a free, LOCAL, keyless web stack for your agent (fetch + search +
  # crawl + screenshot + PDF/OCR). No API keys, no accounts, nothing leaves your
  # machine. Install:  pip install hound-mcp[all] && patchright install chromium
  # - name: hound
  #   command: hound            # no args, no env — just the command
  # - name: filesystem
  #   command: npx
  #   args: [-y, "@modelcontextprotocol/server-filesystem", /workspace]
  # ── HTTP server (points at an already-running server, e.g. hound --http) ──
  # - name: hound-http
  #   url: http://127.0.0.1:8765/mcp
  # - name: my-tool
  #   url: http://localhost:9001/mcp

# Runtime behavior.
runtime:
  # Hot-reload master switch. true (default) = config + prompts + swarm_config are
  # live-edited and changes apply immediately (no restart). false = LOCKED — any
  # change to config/prompts/swarm_config takes effect only after a restart.
  #
  # Read ONCE at startup and never re-read, so this is a setup-time decision: a
  # coding/studying agent that edits its own files can't re-enable live edits.
  # Choose "lock" when you're running an agent that might edit Mneme itself.
  hot_reload: true

# Logging — the proxy owns its own log at $MNEME_CHUNK_DIR/proxy.log (append mode,
# so re-runs and restarts don't wipe it). To cap the size:
#   logging:
#     max_entries: 200    # unset/omit = no limit (default); 0 = logging off; N = keep newest N lines
